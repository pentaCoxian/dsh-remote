{
  "name": "@dsh-remote/push-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Remote push gateway: forwards hosts' sealed notifications to APNs and FCM over iroh; sees only ciphertext",
  "engines": {
    "node": ">=24.9"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --conditions=source src/main.ts"
  },
  "dependencies": {
    "@dsh-remote/iroh-http": "workspace:*",
    "@dsh-remote/protocol": "workspace:*",
    "@number0/iroh": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "rolldown": "1.2.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
