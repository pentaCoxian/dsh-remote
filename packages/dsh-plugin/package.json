{
  "name": "@dsh-remote/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Remote: continue a DeepSeek Harness session from the native phone app over an end-to-end encrypted iroh connection",
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.1-rc.3"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/harness.ts",
      "types": "./dist/testing/harness.d.ts",
      "default": "./dist/testing/harness.js"
    }
  },
  "bin": {
    "dsh-remote": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dsh": "pnpm --filter @dsh-remote/protocol --filter @dsh-remote/iroh-http build && pnpm build && vitest run --config vitest.integration.config.ts test/integration/dsh.itest.ts",
    "dev:host": "node --conditions=source scripts/dev-host.ts",
    "test:relay": "vitest run --config vitest.integration.config.ts test/integration/relay.itest.ts",
    "dev:real-host": "node --conditions=source scripts/real-host.ts"
  },
  "dependencies": {
    "@dsh-remote/iroh-http": "workspace:*",
    "@dsh-remote/protocol": "workspace:*",
    "@number0/iroh": "1.2.0",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@types/qrcode": "1.5.6",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@dsh-remote/push-gateway": "workspace:*"
  }
}
